# Copy to .env (and .env.test for the test database) and fill in real values.
# Never commit real values. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# local | test | production
ENVIRONMENT=local

# Runtime role: DML only (SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgresql+psycopg://home_inventory_app:<password>@localhost:5432/home_inventory
# Migration role: owns schema objects; used only by Alembic
MIGRATION_DATABASE_URL=postgresql+psycopg://home_inventory_migrator:<password>@localhost:5432/home_inventory

# Minimum 32 characters, random. Rotating it invalidates all issued tokens.
JWT_SECRET=<generate-a-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=home-inventory-api
JWT_AUDIENCE=home-inventory-mobile

# JSON list of allowed browser origins. Native mobile clients do not need CORS.
CORS_ORIGINS=[]

# JSON list of host names the API answers to. Required in production (no "*"), e.g.
# ALLOWED_HOSTS=["api.example.com"]. Empty outside production = Host not checked.
ALLOWED_HOSTS=[]

# Google sign-in (optional). Set all three or none; unset = /auth/google/* answer 404.
# Placeholders only: create an OAuth "Web application" client in your own Google Cloud project.
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<from the secret manager, never committed>
# GOOGLE_REDIRECT_URI=https://app.example.com/oauth/google/callback

# Sign in with Apple (optional). Set all five or none; unset = /auth/apple/* answer 404.
# Placeholders only: values come from your own Apple Developer account.
# APPLE_TEAM_ID=<10-char Team ID>
# APPLE_KEY_ID=<10-char Key ID of the Sign in with Apple key>
# APPLE_CLIENT_ID=com.example.homeinventory.signin    # the Services ID
# APPLE_PRIVATE_KEY=<.p8 PEM text from the secret manager; \n-escaped newlines accepted>
# APPLE_REDIRECT_URI=https://app.example.com/oauth/apple/callback
